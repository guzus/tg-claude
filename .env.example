# Enable/disable clients (all default to true)
ENABLE_TELEGRAM=true
ENABLE_DISCORD=true
ENABLE_API=true

# Telegram - required if ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=123456789

# Discord - required if ENABLE_DISCORD=true
# See docs/DISCORD.md for setup guide
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: Restrict to specific Discord user IDs (comma-separated). If not set, all users allowed.
# DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432
# Optional: Set for faster command registration during development
# DISCORD_GUILD_ID=

# Use this if you have a Claude subscription (recommended)
# Token comes from: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Optional (GitHub token for private repos / repo creation)
GITHUB_TOKEN=

# Optional (AI provider keys; you can also set these via `/config`)
OPENROUTER_API_KEY=
GLM_API_KEY=

# Optional timeouts (ms)
API_TIMEOUT_MS=300000
GLM_API_TIMEOUT_MS=300000

# Optional storage paths
# For Docker/Railway one-volume setups, set DATA_PATH=/persistent (see docker-compose.yml)
DATA_PATH=/persistent
# WORKSPACE_PATH=/persistent/workspace
# CONFIG_PATH=/persistent/app/config
# STATE_PATH=/persistent/app/data
# LOGS_PATH=/persistent/app/logs

# Optional health server port
HEALTH_PORT=5555
