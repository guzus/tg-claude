# ============================================================================
# tg-claude Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# See docs/DEPLOYMENT.md for a complete setup guide.
# ============================================================================

# ----------------------------------------------------------------------------
# AUTHENTICATION (Required - pick ONE method)
# ----------------------------------------------------------------------------

# Option 1: Claude Subscription (Recommended)
# Run `claude setup-token` to get this token
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2: Anthropic API Key
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# TELEGRAM CLIENT
# ----------------------------------------------------------------------------

ENABLE_TELEGRAM=true

# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID(s), comma-separated
# Get yours from @userinfobot (https://t.me/userinfobot)
TELEGRAM_ALLOWED_USER_IDS=123456789

# ----------------------------------------------------------------------------
# DISCORD CLIENT (Optional)
# ----------------------------------------------------------------------------
# See docs/DISCORD.md for full setup guide

ENABLE_DISCORD=true

# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# Application Client ID from Discord Developer Portal
DISCORD_CLIENT_ID=

# Restrict to specific Discord user IDs, comma-separated (if not set, all users allowed)
# DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Server ID for faster slash command registration during development
# DISCORD_GUILD_ID=

# ----------------------------------------------------------------------------
# GITHUB INTEGRATION (Optional)
# ----------------------------------------------------------------------------
# Enables: cloning private repos, creating repos via /new_repo, pushing commits

# Personal Access Token from: https://github.com/settings/tokens
GITHUB_PAT=

# ----------------------------------------------------------------------------
# ALTERNATIVE AI PROVIDERS (Optional)
# ----------------------------------------------------------------------------
# You can also configure these via /config command in the bot

# OpenRouter API key (https://openrouter.ai/settings/keys)
# OPENROUTER_API_KEY=

# GLM/Z.ai API key (https://z.ai/manage-apikey/apikey-list)
# GLM_API_KEY=

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION (Optional)
# ----------------------------------------------------------------------------

# Port for health checks, metrics, and API endpoints
API_SERVER_PORT=5555

# Enable/disable the API server
ENABLE_API=true

# ----------------------------------------------------------------------------
# STORAGE PATHS (Optional)
# ----------------------------------------------------------------------------
# For Docker/Railway, set DATA_PATH=/persistent to use a single volume
# All other paths derive from DATA_PATH by default

DATA_PATH=/persistent
# WORKSPACE_PATH=/persistent/workspace
# CONFIG_PATH=/persistent/config
# STATE_PATH=/persistent/state
# LOGS_PATH=/persistent/logs
