# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Security: Comma-separated list of allowed Telegram user IDs
# Get your user ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Workspace Configuration
WORKSPACE_PATH=/path/to/your/projects

# Bot Configuration
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT_MS=1800000
MAX_OUTPUT_SIZE=4096

# Optional: GitHub Configuration (for private repos)
GITHUB_TOKEN=your_github_token_here

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=./logs/bot.log

# Optional: Rate Limiting
MAX_REQUESTS_PER_USER_PER_HOUR=20
MAX_REQUESTS_PER_USER_PER_DAY=100
