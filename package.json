{
  "name": "claude-telegram-bot",
  "version": "0.2.1",
  "description": "TypeScript Telegram bot for controlling Claude Code remotely",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "prepare": "husky"
  },
  "keywords": [
    "telegram",
    "bot",
    "claude",
    "ai",
    "automation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.2",
    "discord.js": "^14.25.1",
    "express": "^4.22.1",
    "node-telegram-bot-api": "^0.66.0",
    "uuid": "^8.3.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.27",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
